# Solo contact.php se sirve desde fuera.
# config.php lleva las credenciales SMTP y smtp.php es una librería:
# ninguno de los dos debe poder pedirse por URL.
<FilesMatch "^(config|smtp)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes
